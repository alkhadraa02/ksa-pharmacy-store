# Copy to .env and adjust. Never commit .env.
DATABASE_URL="file:./dev.db"

# Admin account created by `npm run db:seed` (placeholders - change them)
ADMIN_EMAIL="admin@pharmacy.local"
ADMIN_PASSWORD="change-me-now"

# Set to 1 when served over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=0

# Set to 1 to offer the demo "mock online payment" option at checkout
ENABLE_MOCK_PAYMENT=0

# Public site URL used for sitemap, canonical and Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3113"
